# Formspree form ID for the "Start a conversation" modal.
# Create a form at https://formspree.io and paste your form ID here (e.g. xyzabcde).
# Copy this file to .env.local and set the value.
VITE_FORMSPREE_FORM_ID=

# Password for locked project(s). Set this to protect case studies (e.g. "Leveraging AI to transform clinical compliance in healthcare").
VITE_LOCKED_PROJECT_PASSWORD=

# Vercel deployment token (for CLI deploys). Create at https://vercel.com/account/tokens
# Add to .env.local for: npx vercel --prod
VERCEL_TOKEN=
